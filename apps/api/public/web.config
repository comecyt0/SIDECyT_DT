<?xml version="1.0" encoding="UTF-8"?>
<!--
  COMECYT — IIS reverse proxy + PHP FastCGI (despliegue Windows)
  Un solo sitio enrutando:
    *.php           -> PHP 8.4 via FastCGI (php-cgi.exe)
    archivos reales -> servidos estaticamente por IIS (incluye /storage)
    /api /up        -> Laravel front controller (index.php)
    /app /apps      -> Laravel Reverb (WebSocket) en 127.0.0.1:8080  (ARR)
    resto           -> Next.js standalone en 127.0.0.1:3000          (ARR)
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="PHP-FastCGI" path="*.php" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\php\php-cgi.exe" resourceType="Either" requireAccess="Script" />
    </handlers>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- El modulo WebSocket de IIS debe estar ACTIVO para que ARR complete el handshake 101 hacia Reverb -->
    <webSocket enabled="true" />

    <httpErrors existingResponse="PassThrough" />

    <!-- SIN CACHE DE RESPUESTAS (11/09/2026), defensa en profundidad. Las redirecciones de este sitio
         dependen del ORIGEN de la peticion (ELB o no, ver BALANCEADOR DEL DOMINIO), y una cache que no
         distinga el origen puede entregarle a un cliente la redireccion de otro: bucle infinito para
         los usuarios del ELB. El caso que SI se reprodujo fue la cache interna de URL Rewrite con
         variables concatenadas en una condicion (corregido en las reglas). Antes se sospecho de la
         cache de kernel de HTTP.sys y apagarla NO lo resolvio, pero se deja apagada: tampoco distingue
         el origen, y casi todo lo sirven Next (via ARR) y PHP, sin ganancia apreciable. -->
    <caching enabled="false" enableKernelCache="false" />

    <!-- IIS devuelve 404 para extensiones sin tipo MIME. Necesario para publicar el
         certificado raiz que los equipos cliente deben instalar. -->
    <staticContent>
      <remove fileExtension=".cer" />
      <mimeMap fileExtension=".cer" mimeType="application/x-x509-ca-cert" />
    </staticContent>

    <rewrite>
      <rules>

        <!-- 000) Lista blanca de Host. Hallazgo 5 del pentest de agosto 2026
             ("Possible virtual host found"): el binding `https 10.250.36.241:443:` no fija
             hostname, asi que IIS aceptaba CUALQUIER cabecera Host en 443 y la aplicacion
             respondia igual (307 -> /login). Eso permite fingerprinting de hosts virtuales y
             deja la puerta abierta a envenenamiento de cache por Host.
             Con esta regla, cualquier Host fuera de la lista recibe un 404 seco, sin cuerpo
             ni redireccion, identico para todos los nombres inventados.
             El grupo (:\d+)? es obligatorio: el navegador incluye el puerto en Host cuando
             no es el estandar del esquema.

             NOMBRES AUTORIZADOS:
               10.250.36.241                  via de acceso real hoy (VPN interna)
               127.0.0.1 / localhost          acceso local del propio servidor
               prod-comecyt-siimex            nombre de maquina
               sidecyt-comecyt.edomex.gob.mx  dominio DEFINITIVO (13/08/2026). Publicado el
                                              11/09/2026 detras de un balanceador (ver
                                              BALANCEADOR DEL DOMINIO mas abajo).
                                              GRAFIA CON GUION MEDIO, A PROPOSITO: el guion bajo
                                              no es valido en un nombre DNS (RFC 1123) y el
                                              CA/Browser Forum prohibe "_" en los SAN dNSName,
                                              asi que ninguna CA publica emitiria certificado y
                                              los hallazgos de certificado autofirmado quedarian
                                              abiertos para siempre. No revertir a "_".
               comecyt-sistemas.edomex.gob.mx dominio descartado en julio; se conserva mientras
                                              existan equipos con el hosts apuntando ahi.

             Se retiro "sideyt_comecyt.edomex.gob.mx": era un typo (sin la "c") heredado de un
             binding anterior, ya eliminado de IIS el 13/08/2026.

             PARA AGREGAR UN NOMBRE NUEVO: anadirlo a este patron Y crear el binding en IIS. -->
        <rule name="HostAllowList" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_HOST}"
                 pattern="^(10\.250\.36\.241|127\.0\.0\.1|localhost|prod-comecyt-siimex|sidecyt-comecyt\.edomex\.gob\.mx|comecyt-sistemas\.edomex\.gob\.mx)(:\d+)?$"
                 negate="true" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                  subStatusCode="0" appendQueryString="false" />
        </rule>

        <!-- 00) Certificado publico descargable por HTTP SIN redirigir a HTTPS.
             Necesario para que los equipos cliente puedan instalarlo como raiz de confianza:
             si obligaramos HTTPS aqui, no podrian descargarlo justamente porque aun no confian
             en el certificado. Un certificado es informacion publica, no hay riesgo en servirlo. -->
        <rule name="CertificadoPublico" stopProcessing="true">
          <match url="^certificado-comecyt\.cer$" />
          <action type="None" />
        </rule>

        <!-- 0a) localhost -> HTTPS sobre la IP del servidor.
             Antes apuntaba a comecyt-sistemas.edomex.gob.mx; ese dominio quedo descartado
             (31/07/2026) y sera reemplazado por el dominio institucional cuando se libere en DNS. -->
        <rule name="LocalhostRedirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^localhost$" />
          </conditions>
          <action type="Redirect" url="https://10.250.36.241/{R:1}" redirectType="Found" />
        </rule>

        <!-- 0a-bis) Acceso directo por IP en HTTP -> misma IP pero sobre HTTPS.
             Se redirige a la IP (no al dominio) porque comecyt-sistemas.edomex.gob.mx aun no existe
             en el DNS interno; redirigir al dominio dejaria sin acceso a los equipos de la VPN.
             La condicion {HTTPS}=OFF es obligatoria: sin ella la regla se dispararia tambien sobre
             HTTPS y provocaria un bucle infinito de redirecciones. -->
        <rule name="IpRedirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^10\.250\.36\.241$" />
          </conditions>
          <action type="Redirect" url="https://10.250.36.241/{R:1}" redirectType="Found" />
        </rule>

        <!-- BALANCEADOR DEL DOMINIO (11/09/2026; VIP actualizado el 14/09/2026).
             sidecyt-comecyt.edomex.gob.mx se publico detras de un balanceador (ELB). El DNS resolvia a
             10.200.41.106 y desde la publicacion externa del 14/09/2026 resuelve a 10.200.41.131.
             OJO: ese dato es informativo y NO se configura aqui. Las reglas de abajo no dependen de la
             direccion del ELB, sino de la IP DE ORIGEN con la que el ELB se conecta a este servidor
             (100.64.0.0/10) y de la cabecera X-Forwarded-Proto. Cambiar de VIP no requiere tocar nada;
             cambiar el rango de origen si (ver mas abajo y docs\DOMINIO_BALANCEADOR.md §9 y §12).
             El ELB termina el TLS con su propio certificado (*.edomex.gob.mx, GeoTrust)
             y reenvia a este servidor por HTTP al puerto 80, desde 100.127.0.48, con estas cabeceras
             (verificado con campos personalizados en el log de IIS):
               X-Forwarded-Proto: https    X-Forwarded-Host: sidecyt-comecyt.edomex.gob.mx
               X-Forwarded-Port: 443       X-Forwarded-For / X-Real-IP: IP real del cliente
             IIS ve esa peticion con {HTTPS}=OFF, asi que HttpsRedirect la mandaba a
             https://10.250.36.241/ y el usuario terminaba en la IP.

             Una peticion que ya viajo cifrada hasta el ELB NO se redirige. Se reconoce por DOS
             condiciones a la vez: X-Forwarded-Proto=https Y origen en el rango del ELB
             (100.64.0.0/10, espacio compartido RFC 6598, no enrutable desde los equipos cliente). La
             cabecera sola no basta: cualquiera en la VPN podria mandarla por HTTP directo a la IP y
             saltarse el paso a HTTPS.
             El mismo rango esta en TRUSTED_PROXIES del .env de Laravel: si cambia, cambiar ambos.

             UNA SOLA VARIABLE POR CONDICION, A PROPOSITO. La primera version concatenaba
             {HTTP_X_FORWARDED_PROTO}|{REMOTE_ADDR} en una sola entrada, y la cache interna de URL
             Rewrite (7.2.1993) guardaba el resultado variando por la cabecera pero NO por la IP de
             origen: UNA peticion por HTTP directo a la IP con "X-Forwarded-Proto: https" dejaba en cache
             el 302, y todos los usuarios que llegaban despues por el ELB recibian ese 302 hacia la misma
             URL = bucle infinito. Reproducido y confirmado el 11/09/2026 (sin esa cabecera, o con valor
             "http", no se envenenaba). Como la condicion es un O ("no viene del ELB" O "viene del ELB sin
             https"), cada redireccion se parte en DOS reglas. No volver a concatenar variables aqui. -->

        <!-- 0a-ter) Dominio en HTTP que no llego cifrado al ELB -> HTTPS del DOMINIO, nunca de la IP.
             Destino fijo por la misma razon que en 0b. -->
        <rule name="DominioRedirectFueraDelElb" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^sidecyt-comecyt\.edomex\.gob\.mx(:\d+)?$" />
            <add input="{REMOTE_ADDR}" pattern="^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://sidecyt-comecyt.edomex.gob.mx/{R:1}" redirectType="Found" />
        </rule>
        <rule name="DominioRedirectElbSinTls" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^sidecyt-comecyt\.edomex\.gob\.mx(:\d+)?$" />
            <add input="{REMOTE_ADDR}" pattern="^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+$" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://sidecyt-comecyt.edomex.gob.mx/{R:1}" redirectType="Found" />
        </rule>

        <!-- 0b) Forzar HTTPS para todo lo demas. Destino fijo (la IP), NO {HTTP_HOST}, para no
             reflejar un Host header arbitrario del cliente en la redireccion (Host Header Injection).
             Se usa 302 y no 301 a proposito: un 301 queda cacheado de forma permanente en los
             navegadores y complica revertir o cambiar el destino cuando se libere el dominio.
             Partida en dos por lo explicado en BALANCEADOR DEL DOMINIO: lo que ya llego cifrado al
             ELB pasa sin redireccion. -->
        <rule name="HttpsRedirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
            <add input="{REMOTE_ADDR}" pattern="^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://10.250.36.241/{R:1}" redirectType="Found" />
        </rule>
        <rule name="HttpsRedirectElbSinTls" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
            <add input="{REMOTE_ADDR}" pattern="^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+$" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://10.250.36.241/{R:1}" redirectType="Found" />
        </rule>

        <!-- 1) Reverb WebSocket (protocolo Pusher: /app/{key}) -> Reverb 8080 -->
        <rule name="ReverbWS" stopProcessing="true">
          <match url="^(app|apps)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:0}" />
        </rule>

        <!-- 2) Archivos fisicos existentes (assets, /storage/*) -> servir directo -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url="^.*$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- 3) Rutas propias de Laravel -> front controller index.php (FastCGI) -->
        <rule name="LaravelApi" stopProcessing="true">
          <match url="^(api|up|sanctum|broadcasting)(/.*)?$" />
          <action type="Rewrite" url="index.php" />
        </rule>

        <!-- 4) Todo lo demas (UI) -> Next.js 3000 -->
        <rule name="NextJsProxy" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
        </rule>

      </rules>

      <!-- NOTA: ARR agrega "X-Powered-By: ARR/3.0" a las respuestas que proxea, y lo hace
           DESPUES de <customHeaders>, asi que el <remove> de httpProtocol no la alcanza.
           Se intento con una regla de salida (outboundRules) reescribiendo la cabecera a vacio,
           pero eso no la elimina: deja "X-Powered-By:" con valor vacio, y ademas obliga a IIS a
           inspeccionar todas las respuestas.
           La solucion correcta esta en el propio modulo: arrResponseHeader=False en
           applicationHost.config (system.webServer/proxy), aplicado el 13/08/2026. -->

      <!-- CABECERAS DE SEGURIDAD EN RESPUESTAS QUE NO PASAN POR LA APLICACION (24/08/2026)
           Las cabeceras de seguridad las emiten Laravel (SecurityHeadersMiddleware) y Next.js
           (next.config.ts), asi que cubren todo lo que llega a la aplicacion. Pero IIS genera
           respuestas ANTES de eso y esas salian desnudas. Verificado el 21/08/2026:

             GET /login/../../etc/passwd  -> 403  SIN CSP, SIN HSTS, SIN X-Frame-Options
             TRACE /login                 -> 500  SIN CSP, SIN HSTS, SIN X-Frame-Options

           Esa es exactamente la forma del hallazgo 6 del pentest ("CSP Not Implemented"): si el
           escaner toca una ruta que IIS rechaza antes del rewrite, lo vuelve a levantar.

           POR QUE outboundRules Y NO <customHeaders>: customHeaders agrega la cabecera SIEMPRE,
           tambien cuando la aplicacion ya la puso, y el resultado son cabeceras DUPLICADAS
           (dos Content-Security-Policy en la misma respuesta). Con navegadores eso aplica la
           interseccion de ambas politicas y varios escaneres lo reportan como hallazgo propio.
           Con preCondition sobre {RESPONSE_...} la cabecera se agrega SOLO si viene vacia, asi
           que la aplicacion sigue mandando (es la que sabe que politica necesita cada ruta).

           Esto NO contradice la nota de arriba: ahi el problema era ELIMINAR una cabecera, que
           las reglas de salida no saben hacer (dejan el nombre con valor vacio). AGREGAR cuando
           falta si es un caso que resuelven bien.

           Reescribir server variables RESPONSE_* toca solo cabeceras, no el cuerpo, asi que no
           dispara el error 500.52 de contenido comprimido (ese solo aplica a reglas que
           reescriben el body con filterByTags sobre respuestas gzip).

           HSTS va condicionada ademas a HTTPS: enviarla sobre HTTP esta fuera de norma
           (RFC 6797 sec. 7.2, el cliente debe ignorarla) y algunos escaneres lo marcan. -->
      <outboundRules>

        <!-- HTML SIN CACHE COMPARTIDA (24/09/2026, E42).
             Next.js entrega las paginas prerenderizadas (/sigae, /login) con
             "Cache-Control: s-maxage=31536000": cualquier cache intermedia (el balanceador o un proxy
             de la red del usuario) puede guardar ese HTML UN ANO. Cada `next build` cambia los nombres
             de los archivos JS, asi que tras un despliegue esa copia vieja pide scripts que ya no
             existen, React nunca arranca y la pantalla de carga se queda para siempre ("el dominio
             aparece cargando"). Next no permite cambiar Cache-Control de paginas desde next.config,
             por eso se reescribe aqui para todo HTML y para las respuestas RSC de navegacion.
             Los /_next/static/* (con hash en el nombre) siguen cacheables: no son text/html. -->
        <rule name="HtmlSinCacheCompartida" preCondition="RespuestaHtmlORsc">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="private, no-cache, no-store, max-age=0, must-revalidate" />
        </rule>

        <!-- EXCEPCION PARA /storage/* (26/08/2026).
             Los archivos que adjuntan los solicitantes se muestran al usuario en un iframe dentro
             de la propia aplicacion (DocumentosAdjuntos.tsx, vista previa). Las reglas genericas de
             abajo les ponian "X-Frame-Options: DENY" y "frame-ancestors 'none'", y DENY bloquea el
             marco INCLUSO EN EL MISMO ORIGEN, asi que la vista previa no podia funcionar. No se
             habia notado porque todavia no hay archivos subidos.

             Se relaja SOLO el encuadre y SOLO en /storage/*: 'self' permite que la aplicacion los
             muestre y sigue impidiendo que cualquier otro sitio los incruste. El resto de la
             politica se mantiene igual de restrictivo (default-src 'none', base-uri, form-action),
             y el control de acceso a los archivos no depende de estas cabeceras.

             Estas dos reglas y las genericas son mutuamente excluyentes por {REQUEST_URI}, no por
             orden de evaluacion: cada respuesta cae en una o en la otra, nunca en ambas. -->
        <rule name="CspStorage" preCondition="RespuestaSinCspEnStorage">
          <match serverVariable="RESPONSE_Content_Security_Policy" pattern=".*" />
          <action type="Rewrite" value="default-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'" />
        </rule>

        <rule name="XfoStorage" preCondition="RespuestaSinXfoEnStorage">
          <match serverVariable="RESPONSE_X_Frame_Options" pattern=".*" />
          <action type="Rewrite" value="SAMEORIGIN" />
        </rule>

        <rule name="CspSiFalta" preCondition="RespuestaSinCsp">
          <match serverVariable="RESPONSE_Content_Security_Policy" pattern=".*" />
          <action type="Rewrite" value="default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" />
        </rule>

        <rule name="XfoSiFalta" preCondition="RespuestaSinXfo">
          <match serverVariable="RESPONSE_X_Frame_Options" pattern=".*" />
          <action type="Rewrite" value="DENY" />
        </rule>

        <rule name="XctoSiFalta" preCondition="RespuestaSinXcto">
          <match serverVariable="RESPONSE_X_Content_Type_Options" pattern=".*" />
          <action type="Rewrite" value="nosniff" />
        </rule>

        <rule name="ReferrerSiFalta" preCondition="RespuestaSinReferrer">
          <match serverVariable="RESPONSE_Referrer_Policy" pattern=".*" />
          <action type="Rewrite" value="strict-origin-when-cross-origin" />
        </rule>

        <rule name="HstsSiFalta" preCondition="RespuestaSinHstsEnHttps">
          <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
          <action type="Rewrite" value="max-age=31536000; includeSubDomains" />
        </rule>

        <rule name="HstsSiFaltaElb" preCondition="RespuestaSinHstsEnElb">
          <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
          <action type="Rewrite" value="max-age=31536000; includeSubDomains" />
        </rule>

        <!-- Cross-Origin-Resource-Policy (observacion de ADEM del 25/08/2026, fuera de la matriz).
             INCLUIDO tambien en /storage/* desde el 23/09/2026: se subieron las primeras imagenes
             reales del carrusel (/admin/carrusel) y se confirmo con curl.exe que /storage/* las sirve
             sin esta cabecera. 'same-origin' no estorba la vista previa: es EXACTAMENTE lo que permite
             CORP (bloquea solo el uso desde OTRO origen), el mismo criterio que ya aplica el
             SAMEORIGIN de XfoStorage para el iframe. No hace falta un valor distinto para /storage/*
             como en CSP/XFO (ahi si cambia el valor entre rutas): aqui basta con quitar la exclusion,
             por eso ya no hace falta una regla "CorpStorage" en pareja. -->
        <rule name="CorpSiFalta" preCondition="RespuestaSinCorp">
          <match serverVariable="RESPONSE_Cross_Origin_Resource_Policy" pattern=".*" />
          <action type="Rewrite" value="same-origin" />
        </rule>

        <preConditions>
          <preCondition name="RespuestaHtmlORsc" logicalGrouping="MatchAny">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/x-component" />
          </preCondition>
          <preCondition name="RespuestaSinCsp">
            <add input="{RESPONSE_Content_Security_Policy}" pattern="^$" />
            <add input="{REQUEST_URI}" pattern="^/storage/" negate="true" />
          </preCondition>
          <preCondition name="RespuestaSinCspEnStorage">
            <add input="{RESPONSE_Content_Security_Policy}" pattern="^$" />
            <add input="{REQUEST_URI}" pattern="^/storage/" />
          </preCondition>
          <preCondition name="RespuestaSinXfo">
            <add input="{RESPONSE_X_Frame_Options}" pattern="^$" />
            <add input="{REQUEST_URI}" pattern="^/storage/" negate="true" />
          </preCondition>
          <preCondition name="RespuestaSinXfoEnStorage">
            <add input="{RESPONSE_X_Frame_Options}" pattern="^$" />
            <add input="{REQUEST_URI}" pattern="^/storage/" />
          </preCondition>
          <preCondition name="RespuestaSinXcto">
            <add input="{RESPONSE_X_Content_Type_Options}" pattern="^$" />
          </preCondition>
          <preCondition name="RespuestaSinReferrer">
            <add input="{RESPONSE_Referrer_Policy}" pattern="^$" />
          </preCondition>
          <preCondition name="RespuestaSinHstsEnHttps">
            <add input="{RESPONSE_Strict_Transport_Security}" pattern="^$" />
            <add input="{HTTPS}" pattern="^ON$" />
          </preCondition>
          <!-- HTTPS terminado en el balanceador del dominio: llega por HTTP pero con
               X-Forwarded-Proto=https desde el rango del ELB (ver BALANCEADOR DEL DOMINIO en las reglas
               de entrada). Una variable por condicion, por la misma razon que alla. -->
          <preCondition name="RespuestaSinHstsEnElb">
            <add input="{RESPONSE_Strict_Transport_Security}" pattern="^$" />
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" />
            <add input="{REMOTE_ADDR}" pattern="^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\." />
          </preCondition>
          <preCondition name="RespuestaSinCorp">
            <add input="{RESPONSE_Cross_Origin_Resource_Policy}" pattern="^$" />
          </preCondition>
        </preConditions>

      </outboundRules>
    </rewrite>

    <!-- Ocultar cabeceras que revelan el stack y su version.
         `X-Powered-By` la agregan IIS/ARR y PHP; `Server` la agrega IIS.
         Es la recomendacion que el propio informe de TIC Defense hace en la seccion
         "Identificacion de servicios y tecnologias": no regalar la fase de reconocimiento.
         El X-Powered-By de Next.js se apaga aparte, con poweredByHeader:false en next.config.ts,
         porque viaja en la respuesta proxeada y IIS no la reescribe. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Subir el tope de IIS (default ~28.6 MB) para permitir PDFs hasta 50 MB (coincide con php.ini) -->
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments>
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
