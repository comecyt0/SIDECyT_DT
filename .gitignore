# ── Dependencias ─────────────────────────────────────────────
/apps/api/vendor/
/apps/web/node_modules/
node_modules/
vendor/

# ── Entorno / secretos (NUNCA commitear) ─────────────────────
.env
.env.*
!.env.example
/apps/web/.env.local
SECRETS_GENERADOS.txt
admin_2fa_qr.svg
/backups/
*.dump
pgpass.conf
*.pgpass

# ── Laravel (runtime) ────────────────────────────────────────
/apps/api/storage/logs/*
/apps/api/storage/framework/cache/*
/apps/api/storage/framework/sessions/*
/apps/api/storage/framework/views/*
/apps/api/bootstrap/cache/*.php
/apps/api/public/storage

# ── Next.js (build) ──────────────────────────────────────────
/apps/web/.next/
# Respaldos de builds anteriores (.next.bak-AAAAMMDD-motivo) y de archivos sueltos (*.bak-motivo)
/apps/web/.next.bak*/
*.bak-*
*.tsbuildinfo
# Reporte de cobertura de vitest (npm run test:coverage), se regenera
/apps/web/coverage/
/.claude/
/.agents/
/apps/web/out/
/apps/web/build/

# ── Misc ─────────────────────────────────────────────────────
*.log
/logs/
.DS_Store
Thumbs.db

# E72 (14/10/2026): archivos que suben las personas (documentos de clubes/solicitudes, carrusel, banners). Nunca al repo público.
/apps/api/storage/app/private/
/apps/api/storage/app/public/*
!/apps/api/storage/app/public/.gitignore
